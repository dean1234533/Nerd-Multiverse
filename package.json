{
  "name": "repminder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal-trainer business app (PTminder-style clone): clients, scheduling, session packages, workouts, nutrition, assessments, invoicing and a client portal.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p . && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
