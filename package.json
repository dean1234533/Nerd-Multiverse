{
  "name": "repminder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal-trainer business app (PTminder-style clone): clients, scheduling, session packages, workouts, nutrition, assessments, invoicing and a client portal.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p . && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:firebase": "firebase emulators:exec --project demo-repminder --only auth,firestore \"vitest run --config vitest.firebase.config.ts\"",
    "typecheck": "tsc -p . && tsc -p tsconfig.api.json",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "express": "^4.22.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
