# Copy to .env.local for local development. On Vercel, add the same
# variables under Project → Settings → Environment Variables.

# --- Web app (public; from Firebase console → Project settings → Your apps → Web app) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# --- Server (secret) ---
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=
# Any long random string (12+ characters). You type it once to create your owner account.
SETUP_CODE=

# Optional: use local emulators instead of a real project (npx firebase emulators:start)
# VITE_USE_EMULATORS=1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
